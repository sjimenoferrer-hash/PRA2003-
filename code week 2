#Reading data from an external file and printing it to check the input is read properly
with open("output-Set0.txt", "r") as infile:
    lines = infile.readlines() # confirms the file loaded and shows how many lines it has
    print(f"File read successfully — {len(lines)} lines found.")
    # this "with" blocj at the begging  automatically closes the file once it's done
    
#Define function to calculate the magnitude of their total momentum as p
def calculate_momentum(px, py, pz): 
    p_squared = px**2 + py**2 + pz**2

    if p_squared >= 0: # p_squared should always be positive
        p = p_squared ** 0.5
        return p
    else:
        print("Error")
        return None 

#Open the file, this time without with, so it stays open across the loop 
infile = open("output-Set0.txt", "r") 

# Read and skip the header line before the loop even starts
first_line = infile.readline().split()
event_id = first_line[0]
n_particles = int(first_line[1])

# Now the loop only sees particle lines, and the header line is skipped
print("Event", event_id, "-", n_particles, "particles")

for i in range(n_particles):
    line = infile.readline().split()
    #the different lines indicate the momentum in the x,y,z directions
    px = float(line[0])
    py = float(line[1])
    pz = float(line[2])
    code = line[3]

    p = calculate_momentum(px, py, pz) #calculates the total momentum using the function above 
    print("Particle", i + 1, "| code =", code, "| p =", p) #prints the particles information
